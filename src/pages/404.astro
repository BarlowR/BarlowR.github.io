---
/** Port of the Jekyll `404.html`, rendered in the site chrome. Jekyll gave the
 * page the site-level title (no title of its own), preserved here by omitting
 * the `title` prop. Astro emits this as `dist/404.html`, which GitHub Pages
 * serves for unknown URLs — same as Jekyll's `permalink: /404.html`. */
import Base from '../layouts/Base.astro';
---

<Base>
  <style>
    .container {
      margin: 10px auto;
      max-width: 600px;
      text-align: center;
    }
    h1 {
      margin: 30px 0;
      font-size: 4em;
      line-height: 1;
      letter-spacing: -1px;
    }
  </style>

  <div class="container">
    <h1>404</h1>

    <p><strong>Page not found :(</strong></p>
    <p>The requested page could not be found.</p>
  </div>
</Base>
